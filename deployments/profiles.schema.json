{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "https://github.com/techdigger/open-agentlink-contracts/deployments/profiles.schema.json",
	"title": "AgentLink profile artifact",
	"type": "object",
	"additionalProperties": false,
	"required": ["artifactVersion", "source", "profiles", "partnerOverlays"],
	"properties": {
		"$schema": {
			"type": "string"
		},
		"artifactVersion": {
			"type": "integer",
			"const": 1
		},
		"source": {
			"type": "string"
		},
		"profiles": {
			"type": "array",
			"minItems": 1,
			"items": {
				"$ref": "#/$defs/profile"
			}
		},
		"partnerOverlays": {
			"type": "array",
			"items": {
				"$ref": "#/$defs/partnerOverlay"
			}
		}
	},
	"$defs": {
		"profile": {
			"type": "object",
			"additionalProperties": false,
			"required": ["id", "label", "kind", "status", "chain", "accounts", "biomapper", "registry", "x402", "linker"],
			"properties": {
				"id": {
					"type": "string",
					"pattern": "^[a-z0-9][a-z0-9-]*$"
				},
				"label": {
					"type": "string",
					"minLength": 1
				},
				"kind": {
					"type": "string",
					"enum": ["base", "native", "custom"]
				},
				"status": {
					"type": "string",
					"enum": ["draft", "experimental", "preview", "stable", "deprecated"]
				},
				"chain": {
					"type": "object",
					"additionalProperties": false,
					"required": ["namespace", "chainId", "caip2", "name", "defaultRpcUrls"],
					"properties": {
						"namespace": {
							"type": "string",
							"const": "eip155"
						},
						"chainId": {
							"type": "integer",
							"minimum": 1
						},
						"caip2": {
							"type": "string",
							"pattern": "^eip155:[0-9]+$"
						},
						"name": {
							"type": "string",
							"minLength": 1
						},
						"explorerUrl": {
							"type": "string",
							"format": "uri"
						},
						"defaultRpcUrls": {
							"type": "array",
							"items": {
								"type": "string",
								"format": "uri"
							}
						}
					}
				},
				"accounts": {
					"type": "object",
					"additionalProperties": false,
					"required": ["format"],
					"properties": {
						"format": {
							"type": "string",
							"enum": ["eip55", "caip10"]
						}
					}
				},
				"biomapper": {
					"type": "object",
					"additionalProperties": false,
					"required": ["bridgeAddress", "appUrl"],
					"properties": {
						"bridgeAddress": {
							"$ref": "#/$defs/evmAddress"
						},
						"appUrl": {
							"type": "string",
							"format": "uri"
						}
					}
				},
				"registry": {
					"type": "object",
					"additionalProperties": false,
					"required": ["abiVersion", "status"],
					"properties": {
						"address": {
							"$ref": "#/$defs/evmAddress"
						},
						"deploymentBlock": {
							"type": "string",
							"pattern": "^[0-9]+$"
						},
						"abiVersion": {
							"type": "string",
							"minLength": 1
						},
						"status": {
							"type": "string",
							"enum": ["not-deployed", "deployed", "verified"]
						},
						"explorerUrl": {
							"type": "string",
							"format": "uri"
						}
					}
				},
				"x402": {
					"type": "object",
					"additionalProperties": false,
					"required": ["defaultPaymentNetwork", "defaultFacilitatorUrl", "supportedSchemes"],
					"properties": {
						"defaultPaymentNetwork": {
							"type": "string",
							"pattern": "^eip155:[0-9]+$"
						},
						"defaultFacilitatorUrl": {
							"type": "string",
							"format": "uri"
						},
						"supportedSchemes": {
							"type": "array",
							"items": {
								"type": "string",
								"enum": ["exact"]
							}
						}
					}
				},
				"linker": {
					"type": "object",
					"additionalProperties": false,
					"required": ["enabled", "managementEnabled"],
					"properties": {
						"enabled": {
							"type": "boolean"
						},
						"managementEnabled": {
							"type": "boolean"
						}
					}
				}
			}
		},
		"partnerOverlay": {
			"type": "object",
			"additionalProperties": false,
			"required": ["id", "profileId", "status", "visibility", "owner"],
			"properties": {
				"id": {
					"type": "string",
					"pattern": "^[a-z0-9][a-z0-9-]*$"
				},
				"profileId": {
					"type": "string"
				},
				"status": {
					"type": "string",
					"enum": ["lead", "pilot", "preview", "supported", "sunset"]
				},
				"visibility": {
					"type": "string",
					"enum": ["private", "public"]
				},
				"owner": {
					"type": "string",
					"minLength": 1
				}
			}
		},
		"evmAddress": {
			"type": "string",
			"pattern": "^0x[a-fA-F0-9]{40}$"
		}
	}
}
